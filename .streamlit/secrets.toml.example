# Streamlit Community Cloud secrets 示例
# 在 share.streamlit.io 的 App Settings → Secrets 中填入真实值
# 此文件仅做参考，不要提交真实 key

# 预设 API Keys（UI 中可直接使用，无需手动输入）
# OPENAI_API_KEY = "sk-xxx"
# DEEPSEEK_API_KEY = "sk-xxx"
# ZHIPU_API_KEY = "xxx"
# QWEN_API_KEY = "sk-xxx"
# MOONSHOT_API_KEY = "sk-xxx"
# YI_API_KEY = "xxx"
# GROQ_API_KEY = "gsk_xxx"
